# Environment variables for development
PORT=3000
NODE_ENV=development

# Database connection string for development
# Matches the Postgres service in docker-compose.yml (user osk, password osk, host port 3003)
DATABASE_URL="postgresql://osk:osk@localhost:3003/oskbackend?schema=public"

# Legacy shared API key (unused by HTTP admin routes after Phase 3 session auth)
# ADMIN_API_KEY=

# Redis connection string for production rate limiting
REDIS_URL=

# CORS origins for development (comma-separated). Never use * with credentials.
CORS_ORIGINS=http://localhost:5173, http://localhost:5174

# Cookie-backed admin sessions (Phase 2)
# Session lifetime in seconds (default 8 hours)
SESSION_TTL_SECONDS=28800
# SameSite policy: lax (default; works for localhost and same-site subdomains),
# strict, or none (requires Secure cookies; only for true cross-site frontends)
SESSION_COOKIE_SAMESITE=lax
# In production Secure is always true. For local http://localhost leave unset/false.
# SESSION_COOKIE_SECURE=false

# Cloudinary configuration for development
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# GitHub fine-grained PAT (public repo read) for /projects refresh
GITHUB_TOKEN=

# Optional: used only by `npm run provision:admin` (never commit real values)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
